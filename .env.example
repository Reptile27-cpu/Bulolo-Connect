# BULOLO CONNECT - Environment Configuration Template
# District Digital Services, Community Engagement & Development Management Platform
# Bulolo District, Morobe Province, Papua New Guinea

PORT=5000
NODE_ENV=development

# Database configuration:
# PostgreSQL (Production / Staging):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bulolo_connect?schema=public"
# SQLite (Local Development / Testing):
DATABASE_URL="file:./dev.db"

# Security & Authentication
JWT_SECRET="replace-with-a-very-long-random-secret-key-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# CORS & Client configuration
CORS_ORIGIN="http://localhost:3000"

# File Upload Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Optional Notification Integrations (Can be toggled in admin settings)
SMS_GATEWAY_ENABLED=false
SMS_API_KEY=""
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
